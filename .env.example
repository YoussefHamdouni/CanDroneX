# Copier vers .env (non versionné) : cp .env.example .env

# --- Base de données (conteneur db)
POSTGRES_DB=candronex
POSTGRES_USER=candronex
POSTGRES_PASSWORD=change-me

# --- Application (conteneur app) : le nom d'hôte « db » est celui du service Compose
DATABASE_URL=postgresql+psycopg://candronex:change-me@db:5432/candronex
LOG_LEVEL=INFO

# --- Simulation du cycle de vie (Phase 1, aucun appel réseau)
SIMULATION_DELAY_SECONDS=3
# Types de service dont l'activation simulée échoue, séparés par des virgules (ex. IMAGERY)
SIMULATION_FAILING_SERVICE_TYPES=
